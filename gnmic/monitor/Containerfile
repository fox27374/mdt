# Stage 1: Build
FROM docker.io/library/golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /monitor .

# Stage 2: Runtime
FROM docker.io/library/alpine:3
COPY --from=build /monitor /usr/local/bin/monitor
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/monitor"]
