{
  "name": "port_faceplate",
  "version": "0.1.0",
  "description": "Switch port faceplate for MDT Infrastructure Monitoring",
  "author": "Daniel Kofler",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs --entry=visualization.js",
    "build:prod": "NODE_ENV=production node build.mjs --entry=visualization.js",
    "sync": "NODE_ENV=production node build.mjs --entry=visualization.js && node sync-app.mjs",
    "check": "node check-layout.mjs"
  },
  "devDependencies": {
    "@splunk/dashboard-studio-extension": "^1.0.0",
    "chalk": "^5.3.0",
    "esbuild": "^0.27.3"
  }
}
